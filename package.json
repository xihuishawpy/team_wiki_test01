{
  "name": "team-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @team-wiki/web build",
    "boundaries:check": "eslint apps packages --max-warnings=0",
    "clean": "tsc -b --clean && pnpm --filter @team-wiki/web clean",
    "contracts:generate": "openapi-typescript contracts/openapi.yaml -o contracts/generated/openapi.ts",
    "contracts:lint": "redocly lint contracts/openapi.yaml",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- contracts/generated/openapi.ts",
    "db:migrate": "tsx packages/platform/src/migrations/cli.ts up",
    "db:rollback": "tsx packages/platform/src/migrations/cli.ts down",
    "db:status": "tsx packages/platform/src/migrations/cli.ts status",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start:api": "tsx apps/api/src/main.ts",
    "start:fake-external": "tsx apps/fake-external/src/main.ts",
    "start:worker:publish": "tsx apps/worker/src/main.ts publish",
    "start:worker:classify": "tsx apps/worker/src/main.ts classify",
    "start:worker:reconcile": "tsx apps/worker/src/main.ts reconcile",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm boundaries:check && pnpm contracts:lint && pnpm contracts:check && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm test:browser && pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "jsdom": "29.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
