# Safe local defaults. Copy to .env; never commit real values.
NODE_ENV=development
APP_ROLE=api
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://team_wiki:local_only_change_me@postgres:5432/team_wiki
WORKER_POLL_INTERVAL_MS=1000

# External integrations stay disabled until approved credentials are injected
# into the specific worker role that needs them.
GITHUB_PUBLISH_ENABLED=false
GITHUB_READ_ENABLED=false
MODEL_ENABLED=false
GITHUB_CONTENT_OWNER=local-placeholder
GITHUB_CONTENT_REPO=local-placeholder
GITHUB_CONTENT_BRANCH=main
