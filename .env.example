# Safe local defaults. Copy to .env; never commit real values.
NODE_ENV=development
APP_ROLE=api
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://team_wiki_api:local_api_change_me@postgres:5432/team_wiki
TEAM_WIKI_MIGRATOR_DB_PASSWORD=local_migrator_change_me
TEAM_WIKI_API_DB_PASSWORD=local_api_change_me
TEAM_WIKI_PUBLISH_DB_PASSWORD=local_publish_change_me
TEAM_WIKI_CLASSIFY_DB_PASSWORD=local_classify_change_me
TEAM_WIKI_RECONCILE_DB_PASSWORD=local_reconcile_change_me
WORKER_POLL_INTERVAL_MS=1000

# External integrations stay disabled until approved credentials are injected
# into the specific worker role that needs them.
GITHUB_PUBLISH_ENABLED=false
GITHUB_READ_ENABLED=false
MODEL_ENABLED=false
GITHUB_CONTENT_OWNER=local-placeholder
GITHUB_CONTENT_REPO=local-placeholder
GITHUB_CONTENT_BRANCH=main
